# ====================================================================
# Binance Agent OS — Environment Configuration
# ====================================================================

# API Environment: "testnet" (Binance Demo Trading at demo.binance.com) or "prod"
# To test full order execution with 15,000 FAKE USDT, get free testnet keys at:
# https://demo.binance.com/en/my/settings/api-management
BINANCE_API_ENV=testnet

# Trading Credentials (HMAC API key/secret from demo.binance.com or live sub-account)
# Never use your main account key — always use a sub-account or Demo Trading.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Binance Agent OS MCP Token (OAuth session token from agent.binance.com)
BINANCE_MCP_TOKEN=
BINANCE_MCP_URL=https://agent.binance.com/mcp/agentic

# Safety Switch: Keep true to run deterministic simulations without moving funds.
# Set to false only when you are ready to trade live on demo.binance.com or prod.
DRY_RUN=true
MOCK_MODE=1

# ====================================================================
# Optional AI Provider (Frontier LLM Reasoning)
# ====================================================================
# If left empty, FlashSniper automatically runs the 0-Cost Deterministic Cortex.
ANTHROPIC_API_KEY=

# ====================================================================
# Risk & Execution Safeguards
# ====================================================================
MAX_ALLOCATION_PERCENT=0.02    # Max 2% of sub-account balance per trade
MAX_NOTIONAL_USD=1000          # Hard dollar ceiling per trade
HARD_STOP_LOSS_PERCENT=0.008   # Hard Stop-Loss fixed at -0.8% below wick
TAKE_PROFIT_PERCENT=0.024      # Take-Profit target at +2.4% mean-reversion
MAX_DAILY_LOSS_USD=250         # Daily circuit breaker auto-halt
ALLOWLIST_SYMBOLS=SOLUSDT,BTCUSDT,ETHUSDT,BNBUSDT,DOGEUSDT,PEPEUSDT
